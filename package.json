{
  "name": "duskline",
  "version": "0.1.0",
  "private": false,
  "description": "Free worldwide weather app: city forecasts, air quality, U.S. NWS alerts, and international CAP public alerts.",
  "scripts": {
    "serve": "node tools/static-server.js 8000",
    "check": "node tools/check-js.js",
    "benchmark:map": "node tools/benchmark-map-raster.js",
    "test:unit": "node --test test/*.test.js",
    "test:fast": "npm run check && npm run test:unit",
    "test:core": "playwright test --project=chromium --project=mobile-webkit --grep @core",
    "test:release": "npm run test:fast && npm run test:push-runtime && playwright test",
    "test": "playwright test --project=chromium",
    "test:all": "node --test test/*.test.js && playwright test --project=chromium",
    "readme:i18n": "node tools/render-readme-i18n.js",
    "weather:i18n": "node tools/build-weather-locales.js",
    "test:visual": "playwright test e2e/visual.spec.js --project=chromium",
    "test:cross": "playwright test --project=firefox --project=webkit --project=mobile-webkit",
    "test:push-runtime": "node tools/check-push-runtime.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "wrangler": "4.149.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  }
}
