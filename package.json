{
  "name": "duskline",
  "version": "0.1.0",
  "private": false,
  "description": "Free worldwide weather app: city forecasts, air quality, and U.S. NWS alerts.",
  "scripts": {
    "serve": "node tools/static-server.js 8000",
    "check": "node tools/check-js.js",
    "test:unit": "node --test test/*.test.js",
    "test": "playwright test",
    "test:all": "node --test test/*.test.js && playwright test",
    "readme:i18n": "node tools/render-readme-i18n.js"
  },
  "devDependencies": { "@playwright/test": "^1.55.0" },
  "license": "MIT",
  "engines": { "node": ">=18" }
}
